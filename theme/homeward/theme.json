    "spacing": {
      "units": [
        "px",
        "rem",
        "em",
        "%",
        "vw"
      ],
      "defaultSpacingSizes": false,
      "spacingSizes": [
        {
          "slug": "20",
          "name": "Small",
          "size": "0.5rem"
        },
        {
          "slug": "30",
          "name": "Medium",
          "size": "1rem"
        },
        {
          "slug": "40",
          "name": "Large",
          "size": "2rem"
        },
        {
          "slug": "50",
          "name": "Section",
          "size": "clamp(2.5rem, 5vw, 4rem)"
        },
        {
          "slug": "60",
          "name": "Wide section",
          "size": "clamp(3rem, 7vw, 6rem)"
        }
      ]
    },
    "custom": {
      "radius": "0.375rem"
    }
  },
  "styles": {
    "color": {
      "background": "var:preset|color|background",
      "text": "var:preset|color|ink"
    },
    "typography": {
      "fontFamily": "var:preset|font-family|body",
      "fontSize": "var:preset|font-size|medium",
      "lineHeight": "1.65"
    },
    "spacing": {
      "blockGap": "1.5rem",
      "padding": {
        "left": "clamp(1rem, 4vw, 3rem)",
        "right": "clamp(1rem, 4vw, 3rem)"
      }
    },
    "elements": {
      "heading": {
        "color": {
          "text": "var:preset|color|primary"
        },
        "typography": {
          "fontFamily": "var:preset|font-family|heading",
          "fontWeight": "600",
          "lineHeight": "1.15"
        }
      },
      "h1": {
        "typography": {
          "fontSize": "var:preset|font-size|xx-large"
        }
      },
      "h2": {
        "typography": {
          "fontSize": "var:preset|font-size|x-large"
        }
      },
      "h3": {
        "typography": {
          "fontSize": "1.5rem"
        }
      },
      "link": {
        "color": {
          "text": "var:preset|color|primary"
        },
        "typography": {
          "textDecoration": "underline"
        },
        ":hover": {
          "color": {
            "text": "var:preset|color|ink"
          }
        }
      },
      "button": {
        "color": {
          "background": "var:preset|color|primary",
          "text": "var:preset|color|surface"
        },
        "border": {
          "radius": "0.375rem"
        },
        "spacing": {
          "padding": {
            "top": "0.75rem",
            "bottom": "0.75rem",
            "left": "1.25rem",
            "right": "1.25rem"
          }
        },
        "typography": {
          "fontFamily": "var:preset|font-family|body",
          "fontSize": "1rem",
          "fontWeight": "600",
          "lineHeight": "1.5"
        }
      }
    },
    "blocks": {
      "core/site-title": {
        "typography": {
          "fontFamily": "var:preset|font-family|heading",
          "fontSize": "1.5rem",
          "fontWeight": "600"
        },
        "elements": {
          "link": {
            "typography": {
              "textDecoration": "none"
            }
          }
        }
      },
      "core/navigation": {
        "typography": {
          "fontFamily": "var:preset|font-family|body",
          "fontSize": "1rem",
          "fontWeight": "600"
        },
        "color": {
          "text": "var:preset|color|primary"
        }
      },
      "core/post-title": {
        "elements": {
          "link": {
            "typography": {
              "textDecoration": "none"
            }
          }
        }
      },
      "core/quote": {
        "border": {
          "left": {
            "color": "var:preset|color|accent",
            "width": "3px"
          }
        },
        "spacing": {
          "padding": {
            "left": "1.5rem"
          }
        }
      },
      "core/separator": {
        "color": {
          "text": "var:preset|color|accent"
        }
      }
    }
  },
  "templateParts": [
    {
      "name": "header",
      "title": "Header",
      "area": "header"
    },
    {
      "name": "footer",
      "title": "Footer",
      "area": "footer"
    }
  ]
}
