# Copy to .scan-secrets.local (untracked) and replace the placeholders.
# One regex per line. Lines starting with # are comments.
# Prefixes:
#   org: REGEX     organisation name; allowed inside allowed sections below
#   case: REGEX    case-sensitive (the default is case-insensitive)
#   allow-section: FILE :: HEADING   org: rules are skipped under that "## HEADING"

# Personal names and handles
example-person
case: Exampleman

# Reference organisation (name variants and its identifiers)
org: example-org-name
org: example org ?name
000000
example\.test/donate-handle

allow-section: README.md :: Live reference
